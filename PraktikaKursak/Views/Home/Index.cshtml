﻿@{
ViewData["Title"] = "Главная";
}

<div class="hero">
    <h1 class="hero-title">Фотостудия<br>ART-Кадр</h1>
    <p class="hero-subtitle">Минимализм. Качество. Современный подход.</p>
    <a asp-controller="Services" asp-action="Index" class="btn btn-primary">Смотреть услуги →</a>
</div>

<div class="features">
    <div class="features-item">
        <div class="features-icon">📸</div>
        <h3>Профессиональная съёмка</h3>
        <p>Современное оборудование, опытные фотографы.</p>
    </div>
    <div class="features-item">
        <div class="features-icon">🎨</div>
        <h3>Ретушь и обработка</h3>
        <p>Тонкая цветокоррекция, ретушь любой сложности.</p>
    </div>
    <div class="features-item">
        <div class="features-icon">📚</div>
        <h3>Фотокниги</h3>
        <p>Уникальные фотокниги премиум-качества.</p>
    </div>
</div>

<div class="hero-image">
    <img src="~/images/studio.jpg" alt="Фотостудия" />
</div>

<!-- Слайдер локаций -->
<style>
    .locations-slider-container {
        position: relative;
        max-width: 100%;
        margin: 80px auto 40px;
        overflow: hidden;
        border-radius: 20px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.15);
    }

    .locations-slider {
        display: flex;
        transition: transform 0.5s ease-in-out;
    }

    .location-slide {
        min-width: 100%;
        position: relative;
    }

        .location-slide img {
            width: 100%;
            height: 500px;
            object-fit: cover;
        }

    .location-caption {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(transparent, rgba(0,0,0,0.8));
        color: white;
        padding: 50px 30px 30px;
        text-align: center;
    }

        .location-caption h3 {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .location-caption p {
            font-size: 16px;
            opacity: 0.9;
        }

    .slider-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(0,0,0,0.5);
        color: white;
        border: none;
        padding: 15px 22px;
        cursor: pointer;
        font-size: 24px;
        border-radius: 50%;
        transition: all 0.3s;
        z-index: 10;
    }

        .slider-btn:hover {
            background: rgba(0,0,0,0.8);
            transform: translateY(-50%) scale(1.1);
        }

    .slider-prev {
        left: 20px;
    }

    .slider-next {
        right: 20px;
    }

    .slider-dots {
        text-align: center;
        padding: 20px;
        background: var(--bg-card);
    }

    .dot {
        display: inline-block;
        width: 12px;
        height: 12px;
        margin: 0 6px;
        background: var(--text-secondary);
        border-radius: 50%;
        cursor: pointer;
        transition: all 0.3s;
    }

        .dot.active {
            background: var(--text-primary);
            transform: scale(1.3);
        }

    .section-subtitle {
        text-align: center;
        font-size: 14px;
        color: var(--text-secondary);
        margin-bottom: 20px;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .section-title-light {
        text-align: center;
        font-size: 36px;
        font-weight: 600;
        margin-bottom: 40px;
        color: var(--text-primary);
    }

    .location-caption h3 {
        font-size: 18px;
    }

    .location-caption p {
        font-size: 12px;
    }

    .slider-btn {
        padding: 8px 14px;
        font-size: 16px;
    }

    .section-title-light {
        font-size: 24px;
    }

    }</style>

<div class="section-title-light">Наши локации</div>
<div class="section-subtitle">Идеальные пространства для ваших фотосессий</div>

<div class="locations-slider-container">
    <div class="locations-slider" id="locationsSlider">
        <div class="location-slide">
            <img src="~/images/location1.jpg" alt="Студийная локация Loft">
            <div class="location-caption">
                <h3>Студийная локация "Loft"</h3>
                <p>Просторный зал с натуральным светом, кирпичные стены, современный интерьер</p>
            </div>
        </div>
        <div class="location-slide">
            <img src="~/images/location2.jpg" alt="Зелёная студия Ботаника">
            <div class="location-caption">
                <h3>Зелёная студия "Ботаника"</h3>
                <p>Живые растения, уютная атмосфера, идеально для семейных фотосессий</p>
            </div>
        </div>
        <div class="location-slide">
            <img src="~/images/location3.jpg" alt="Белая студия Minimal">
            <div class="location-caption">
                <h3>Белая студия "Minimal"</h3>
                <p>Минималистичный дизайн, чистые линии, идеальный свет для портретов</p>
            </div>
        </div>
        <div class="location-slide">
            <img src="~/images/location4.jpg" alt="Натуральный свет Home">
            <div class="location-caption">
                <h3>Натуральный свет "Home"</h3>
                <p>Домашняя атмосфера, панорамные окна, уютные зоны для съёмки</p>
            </div>
        </div>
    </div>

    <button class="slider-btn slider-prev" onclick="prevLocation()">❮</button>
    <button class="slider-btn slider-next" onclick="nextLocation()">❯</button>
</div>

<div class="slider-dots" id="locationDots"></div>

<script>
    let currentLocationSlide = 0;
    const locationSlides = document.querySelectorAll('.location-slide');
    const locationTotalSlides = locationSlides.length;
    const locationSlider = document.getElementById('locationsSlider');

    function updateLocationDots() {
        const dots = document.querySelectorAll('#locationDots .dot');
        dots.forEach((dot, index) => {
            dot.classList.toggle('active', index === currentLocationSlide);
        });
    }

    function goToLocationSlide(index) {
        if (index < 0) index = locationTotalSlides - 1;
        if (index >= locationTotalSlides) index = 0;
        currentLocationSlide = index;
        locationSlider.style.transform = `translateX(-${currentLocationSlide * 100}%)`;
        updateLocationDots();
    }

    function nextLocation() {
        goToLocationSlide(currentLocationSlide + 1);
    }

    function prevLocation() {
        goToLocationSlide(currentLocationSlide - 1);
    }

    // Создание точек
    const locationDotsContainer = document.getElementById('locationDots');
    for (let i = 0; i < locationTotalSlides; i++) {
        const dot = document.createElement('div');
        dot.classList.add('dot');
        dot.onclick = () => goToLocationSlide(i);
        locationDotsContainer.appendChild(dot);
    }
    updateLocationDots();

    // Автоматическое переключение каждые 5 секунд
    let autoSlide = setInterval(() => {
        nextLocation();
    }, 5000);

    // Остановка автопереключения при наведении
    const container = document.querySelector('.locations-slider-container');
    container.addEventListener('mouseenter', () => {
        clearInterval(autoSlide);
    });

    container.addEventListener('mouseleave', () => {
        autoSlide = setInterval(() => {
            nextLocation();
        }, 5000);
    });
</script>