<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Фотостудия ART-Кадр</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/light-theme.css" asp-append-version="true" id="theme-stylesheet" />
</head>
<body>

    <div class="app">
        <header class="header">
            <div class="container">
                <div class="header-inner">
                    <a asp-controller="Home" asp-action="Index" class="logo">
                        <img src="~/images/logo.jpg" alt="Логотип" class="logo-img" />
                        <span class="logo-text">ART-Кадр</span>
                    </a>

                    <nav class="nav">
                        <a asp-controller="Home" asp-action="Index" class="nav-link">Главная</a>
                        <a asp-controller="Services" asp-action="Index" class="nav-link">Услуги</a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Booking" asp-action="Index" class="nav-link">Мои бронирования</a>
                        }
                        <a asp-controller="Portfolio" asp-action="Index" class="nav-link">Портфолио</a>
                        <a asp-controller="Contacts" asp-action="Index" class="nav-link">Контакты</a>
                    </nav>

                    <div class="auth-links" style="display: flex; gap: 15px; align-items: center;">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span style="font-size: 14px;">@User.Identity.Name</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" style="display: inline;">
                                <button type="submit" class="nav-link" style="background: none; border: none; cursor: pointer;">Выйти</button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="nav-link">Вход</a>
                            <a asp-controller="Account" asp-action="Register" class="nav-link">Регистрация</a>
                        }
                    </div>

                    <div class="theme-switcher">
                        <button type="button" id="theme-light-btn" class="theme-btn" onclick="switchTheme('light')" title="Светлая тема" style="font-size: 22px; background: none; border: none; cursor: pointer; padding: 6px 10px;">☀️</button>
                        <button type="button" id="theme-dark-btn" class="theme-btn" onclick="switchTheme('dark')" title="Тёмная тема" style="font-size: 22px; background: none; border: none; cursor: pointer; padding: 6px 10px;">🌙</button>
                    </div>
                </div>
            </div>
        </header>

        <main class="main">
            <div class="container">
                @RenderBody()
            </div>
        </main>

        <footer class="footer">
            <div class="container">
                <div class="footer-inner">
                    <p>&copy; @DateTime.Now.Year ART-Кадр. Все права защищены.</p>
                    <div class="footer-links">
                        <a asp-controller="Home" asp-action="Index">Главная</a>
                        <a asp-controller="Services" asp-action="Index">Услуги</a>
                        <a asp-controller="Booking" asp-action="Index">Бронирования</a>
                        <a asp-controller="Portfolio" asp-action="Index">Портфолио</a>
                        <a asp-controller="Contacts" asp-action="Index">Контакты</a>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme-switcher.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>