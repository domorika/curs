@{
    ViewData["Title"] = "Главная";
}

<div class="hero">
    <h1 class="hero-title">Фотостудия<br>ART-Кадр</h1>
    <p class="hero-subtitle">Минимализм. Качество. Современный подход.</p>
    <a asp-controller="Services" asp-action="Index" class="btn btn-primary">Смотреть услуги →</a>
</div>

<div class="features">
    <div class="features-item">
        <div class="features-icon"></div>
        <h3>Профессиональная съёмка</h3>
        <p>Современное оборудование, опытные фотографы.</p>
    </div>
    <div class="features-item">
        <div class="features-icon"></div>
        <h3>Ретушь и обработка</h3>
        <p>Тонкая цветокоррекция, ретушь любой сложности.</p>
    </div>
    <div class="features-item">
        <div class="features-icon"></div>
        <h3>Фотокниги</h3>
        <p>Уникальные фотокниги премиум-качества.</p>
    </div>
</div>

<div class="hero-image">
    <img src="~/images/studio.jpg" alt="Фотостудия" />
</div>